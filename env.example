# Kopyalayın: cp env.example .env.local  — Vercel'de: Project > Settings > Environment Variables

# --- Tarayıcıya açık (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://event-radar.vercel.app
# Prod'da DB boşken demo etkinlikleri göstermek için true (varsayılan: kapalı)
NEXT_PUBLIC_DEMO_MODE=false

# --- Yalnızca sunucu (asla NEXT_PUBLIC_ öneki vermeyin) ---
# Supabase Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Admin paneli şifresi (en az 12 karakter)
ADMIN_PASSWORD=change-me-to-a-long-password
# Oturum imzalama anahtarı (en az 32 karakter). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=change-me

# --- Opsiyonel (scripts/enrich_events.ts) ---
GEMINI_API_KEY=
